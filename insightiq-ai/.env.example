# ==========================================
# InsightIQ AI - Environment Configuration Template
# Copy this file to .env and populate real credentials.
# NEVER commit the real .env file into version control.
# ==========================================

# ------------------------------------------
# General Application Settings
# ------------------------------------------
ENVIRONMENT=development
DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------
# PostgreSQL Database Settings
# ------------------------------------------
POSTGRES_USER=insightiq_user
POSTGRES_PASSWORD=insightiq_password
POSTGRES_DB=insightiq_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://insightiq_user:insightiq_password@localhost:5432/insightiq_db

# ------------------------------------------
# OpenAI API Settings (LLM & Function Calling)
# ------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30

# ------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------
VITE_API_URL=http://localhost:8000
